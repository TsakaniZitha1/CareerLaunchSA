<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CareerLaunchSA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (Green) -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color (Bright Green) -->
        <item name="colorSecondary">@color/bright_green</item>
        <item name="colorSecondaryVariant">@color/bright_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color (Matches the app background/header) -->
        <item name="android:statusBarColor">@color/primary_green</item>

        <!-- Explicitly remove ActionBar/Title for older systems -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Fixed: This controls the focused outline color of input fields -->
        <item name="colorAccent">@color/primary_green</item>
        <item name="colorControlActivated">@color/primary_green</item>
        <item name="colorControlHighlight">@color/primary_emerald_light</item>
    </style>
</resources>